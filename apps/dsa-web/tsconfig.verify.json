{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "outDir": "/tmp/verify_cjs",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src/**/*", "scripts/verify_*.tsx"]
}
